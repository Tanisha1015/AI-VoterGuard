# URLs
CORE_URL=http://localhost:8000
AGENT_URL=http://localhost:8001
TRUST_URL=http://localhost:8002
CHAIN_RPC_URL=http://127.0.0.1:8545

# Core API (A)
AUTO_SEED=true
CLAIMS_DEADLINE=2026-10-31
AGENT_TIMEOUT_SECONDS=8

# Agent service (A), Cline SDK
PORT=8001
ANTHROPIC_API_KEY=
AGENT_PROVIDER_ID=anthropic
AGENT_MODEL_ID=claude-sonnet-5-5
MOCK_AGENT=false

# Trust service (B)
TRUST_PORT=8002
SUBMITTER_PRIVATE_KEY=   # Hardhat account #1 key, local only
REPORT_DIR=./data/reports

# Frontend (B), in frontend/.env
VITE_CORE_URL=http://localhost:8000
VITE_TRUST_URL=http://localhost:8002
VITE_USE_MOCKS=true
