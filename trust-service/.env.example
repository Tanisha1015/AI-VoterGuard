# Trust service (:8002). Copy values into your shell or a local env file; never commit real keys.
CORE_URL=http://localhost:8000
CHAIN_RPC_URL=http://127.0.0.1:8545
# Hardhat account #1 private key (local development node only). Printed by `npm run node` in chain/.
SUBMITTER_PRIVATE_KEY=
REPORT_DIR=./data/reports
